<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<HBox alignment="CENTER" prefHeight="268.0" prefWidth="495.0" spacing="20" xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.quanlybansach_java.CONTROLLER.LoginController">
    <ImageView>
        <image>
            <Image url="@../img/login_image.jpg" />
        </image>
        <fitWidth>218.0</fitWidth>
        <fitHeight>278.0</fitHeight>
    </ImageView>

    <VBox alignment="CENTER" prefHeight="274.0" prefWidth="262.0" spacing="10">
        <Label alignment="CENTER">
            <text>Login</text>
            <font>
                <Font size="16.0" />
            </font>
        </Label>

        <HBox alignment="CENTER" spacing="10">
            <Label text="Username:" />
            <TextField fx:id="usernameField" promptText="Username" />
        </HBox>

        <HBox alignment="CENTER" spacing="10">
            <Label text="Password:" />
            <PasswordField fx:id="passwordField" promptText="Password" />
        </HBox>

        <Button onAction="#handleLoginButtonAction" text="Login" />
      <padding>
         <Insets right="20.0" />
      </padding>
    </VBox>
</HBox>
